{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "npm run sitemap && react-snap",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "reactSnap": {
    "source": "dist",
    "crawl": false,
    "include": [
      "/",
      "/about",
      "/contact",
      "/learn",
      "/roadmaps",
      "/projects",
      "/interview-prep",
      "/community"
    ]
  },
  "dependencies": {
